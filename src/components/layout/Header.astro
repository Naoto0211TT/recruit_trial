---
import Button from '@/components/ui/Button.astro';
import { lpAssets } from '@/constants/assets';
import { site } from '@/constants/content';
---

<header
  class="absolute inset-x-0 top-0 z-50 flex h-[6rem] items-center justify-between bg-transparent pr-0 pl-[1.6rem] text-black md:h-[100px] md:pr-[12px] md:pl-[36px] md:text-white"
  data-header
>
  <p class="leading-body text-[1.5rem] tracking-[0.375px] md:text-[22px] md:tracking-[0.55px]">
    {site.name}
  </p>

  <div class="flex h-full items-center justify-end md:flex-1 md:gap-[12px]">
    <div class="hidden items-center gap-[32px] md:flex">
      <div class="flex flex-col items-center gap-[8px]">
        <div class="flex items-center gap-[8px]">
          <span
            class="font-lato leading-heading border-b border-white pb-[2px] text-[13px] font-medium tracking-[2.6px]"
          >
            TEL
          </span>
          <a
            class="font-lato text-[24px] leading-[1.25] font-medium"
            href={`tel:${site.tel.replace(/-/g, '')}`}
          >
            {site.tel}
          </a>
        </div>
        <p class="text-[11px] leading-none">{site.telHours}</p>
      </div>
      <Button
        class="w-[200px]"
        href="#contact"
      />
    </div>

    <div class="flex h-full items-center gap-[1.6rem] md:hidden">
      <a
        aria-label="メールでのお問い合わせ"
        class="flex size-[2.4rem] items-center justify-center"
        href="#contact"
      >
        <img
          alt=""
          class="size-full"
          height="24"
          src={lpAssets.iconMail}
          width="24"
        />
      </a>
      <a
        aria-label="お電話でのお問い合わせ"
        class="flex size-[2.4rem] items-center justify-center"
        href={`tel:${site.tel.replace(/-/g, '')}`}
      >
        <img
          alt=""
          class="size-full"
          height="24"
          src={lpAssets.iconPhoneCircle}
          width="24"
        />
      </a>
    </div>

    <button
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="メニューを開く"
      class="bg-dark-gray flex h-full w-[6rem] flex-col items-center gap-[0.8rem] pt-[1.6rem] text-white md:w-[100px] md:pt-[36px]"
      data-menu-open
      type="button"
    >
      <span
        class="font-lato text-[0.9rem] leading-none tracking-[0.45px] md:text-[11px] md:tracking-[0.55px]"
      >
        MENU
      </span>
      <span
        aria-hidden="true"
        class="h-[0.8rem] w-[2.4rem] border-t border-b border-white md:w-[32px]"
      ></span>
    </button>
  </div>
</header>

<header
  class="bg-dark-gray/95 fixed inset-x-0 top-0 z-40 hidden h-[6rem] items-center justify-between border-b border-white/10 px-[1.6rem] text-white backdrop-blur md:h-[100px] md:px-[36px]"
  data-header-fixed
>
  <p class="leading-body text-[1.5rem] tracking-[0.375px] md:text-[22px] md:tracking-[0.55px]">
    {site.name}
  </p>
  <button
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label="メニューを開く"
    class="bg-dark-gray flex h-[6rem] w-[6rem] flex-col items-center justify-center gap-[0.8rem] md:h-[100px] md:w-[100px]"
    data-menu-open
    type="button"
  >
    <span
      class="font-lato text-[0.9rem] leading-none tracking-[0.45px] md:text-[11px] md:tracking-[0.55px]"
    >
      MENU
    </span>
    <span
      aria-hidden="true"
      class="h-[0.8rem] w-[2.4rem] border-t border-b border-white md:w-[32px]"
    ></span>
  </button>
</header>

<script>
  const hero = document.querySelector('[data-hero]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const fixedHeader = document.querySelector<HTMLElement>('[data-header-fixed]');

  const toggleFixedHeader = () => {
    if (!hero || !header || !fixedHeader) return;

    const threshold = hero.getBoundingClientRect().height - 100;
    const showFixed = window.scrollY > threshold;

    fixedHeader.classList.toggle('hidden', !showFixed);
    fixedHeader.classList.toggle('flex', showFixed);
    header.classList.toggle('opacity-0', showFixed);
    header.classList.toggle('pointer-events-none', showFixed);
  };

  toggleFixedHeader();
  window.addEventListener('scroll', toggleFixedHeader, { passive: true });
</script>
