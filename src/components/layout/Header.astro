---
import Button from '@/components/ui/Button.astro';
import { lpAssets } from '@/constants/assets';
import { site } from '@/constants/content';
---

<header
  class="absolute inset-x-0 top-0 z-50 mx-auto flex h-[60px] max-w-[1440px] items-center justify-between bg-transparent pr-0 pl-4 text-black md:h-[clamp(60px,6.9444vw,100px)] md:pr-[clamp(0px,0.8333vw,12px)] md:pl-[clamp(16px,2.5vw,36px)] md:text-white"
  data-header
>
  <p
    class="leading-body text-[15px] tracking-[0.375px] md:text-[clamp(15px,1.5278vw,22px)] md:tracking-[0.55px]"
  >
    {site.name}
  </p>

  <div class="flex h-full items-center justify-end md:flex-1 md:gap-[clamp(0px,0.8333vw,12px)]">
    <div class="hidden items-center gap-[clamp(0px,2.2222vw,32px)] md:flex">
      <div class="flex flex-col items-center gap-[clamp(0px,0.5556vw,8px)]">
        <div class="flex items-center gap-[clamp(0px,0.5556vw,8px)]">
          <span
            class="font-lato leading-heading border-b border-white pb-0.5 text-[clamp(11px,0.9028vw,13px)] font-medium tracking-[2.6px]"
          >
            TEL
          </span>
          <a
            class="font-lato text-[clamp(18px,1.6667vw,24px)] leading-[1.25] font-medium"
            href={`tel:${site.tel.replace(/-/g, '')}`}
          >
            {site.tel}
          </a>
        </div>
        <p class="text-[clamp(10px,0.7639vw,11px)] leading-none">{site.telHours}</p>
      </div>
      <Button
        class="w-[clamp(160px,13.8889vw,200px)]"
        href="#contact"
      />
    </div>

    <div class="flex h-full items-center gap-4 md:hidden">
      <a
        aria-label="メールでのお問い合わせ"
        class="flex size-6 items-center justify-center"
        href="#contact"
      >
        <img
          alt=""
          class="size-6"
          height="24"
          src={lpAssets.iconMail}
          width="24"
        />
      </a>
      <a
        aria-label="お電話でのお問い合わせ"
        class="flex size-6 items-center justify-center"
        href={`tel:${site.tel.replace(/-/g, '')}`}
      >
        <img
          alt=""
          class="size-6"
          height="24"
          src={lpAssets.iconPhoneCircle}
          width="24"
        />
      </a>
    </div>

    <button
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="メニューを開く"
      class="bg-dark-gray flex h-full w-[60px] flex-col items-center gap-2 pt-4 text-white md:w-[clamp(60px,6.9444vw,100px)] md:pt-[clamp(16px,2.5vw,36px)]"
      data-menu-open
      type="button"
    >
      <span
        class="font-lato text-[9px] leading-none tracking-[0.45px] md:text-[clamp(9px,0.7639vw,11px)] md:tracking-[0.55px]"
      >
        MENU
      </span>
      <span
        aria-hidden="true"
        class="h-2 w-6 border-t border-b border-white md:w-[clamp(24px,2.2222vw,32px)]"
      ></span>
    </button>
  </div>
</header>

<header
  class="bg-dark-gray/95 fixed inset-x-0 top-0 z-40 mx-auto hidden h-[60px] max-w-[1440px] items-center justify-between border-b border-white/10 px-4 text-white backdrop-blur md:h-[clamp(60px,6.9444vw,100px)] md:px-[clamp(16px,2.5vw,36px)]"
  data-header-fixed
>
  <p
    class="leading-body text-[15px] tracking-[0.375px] md:text-[clamp(15px,1.5278vw,22px)] md:tracking-[0.55px]"
  >
    {site.name}
  </p>
  <button
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label="メニューを開く"
    class="bg-dark-gray flex h-[60px] w-[60px] flex-col items-center justify-center gap-2 md:h-[clamp(60px,6.9444vw,100px)] md:w-[clamp(60px,6.9444vw,100px)]"
    data-menu-open
    type="button"
  >
    <span
      class="font-lato text-[9px] leading-none tracking-[0.45px] md:text-[clamp(9px,0.7639vw,11px)] md:tracking-[0.55px]"
    >
      MENU
    </span>
    <span
      aria-hidden="true"
      class="h-2 w-6 border-t border-b border-white md:w-[clamp(24px,2.2222vw,32px)]"
    ></span>
  </button>
</header>

<script>
  const hero = document.querySelector('[data-hero]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const fixedHeader = document.querySelector<HTMLElement>('[data-header-fixed]');

  const toggleFixedHeader = () => {
    if (!hero || !header || !fixedHeader) return;

    const threshold = hero.getBoundingClientRect().height - 100;
    const showFixed = window.scrollY > threshold;

    fixedHeader.classList.toggle('hidden', !showFixed);
    fixedHeader.classList.toggle('flex', showFixed);
    header.classList.toggle('opacity-0', showFixed);
    header.classList.toggle('pointer-events-none', showFixed);
  };

  toggleFixedHeader();
  window.addEventListener('scroll', toggleFixedHeader, { passive: true });
</script>
