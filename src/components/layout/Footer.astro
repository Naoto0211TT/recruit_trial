---
import { iconAssets } from '@/constants/assets';
import { footer, site } from '@/constants/content';
---

<footer
  class="bg-dark-gray text-white"
  id="contact"
>
  <div class="lp-container flex flex-col gap-[6rem] pt-[6rem] pb-[4rem] md:gap-[80px] md:py-[60px]">
    <div class="flex w-full flex-col items-center gap-[2rem] md:gap-[28px]">
      <div
        class="flex w-full items-start justify-center border-b border-white/10 pb-[2rem] md:w-auto md:border-0 md:pb-0"
      >
        <p class="text-[1.6rem] leading-[1.75] font-bold tracking-[0.4px]">
          {footer.telHeading}
        </p>
      </div>
      <div class="flex items-center gap-[1.6rem] md:gap-[24px]">
        <img
          alt=""
          class="size-[5.2rem] md:size-[60px]"
          height="60"
          loading="lazy"
          src={iconAssets.phoneCircle}
          width="60"
        />
        <div class="leading-none">
          <a
            class="font-lato inline-block text-[2.4rem] leading-none font-light tracking-[0.48px] md:text-[36px] md:tracking-[0.72px]"
            href={`tel:${site.tel.replace(/-/g, '')}`}
          >
            {site.tel}
          </a>
          <p class="mt-[0.4rem] text-[1rem] tracking-[0.25px] md:text-[13px] md:tracking-[0.325px]">
            {site.telHours}
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center">
      <a
        class="group flex flex-col items-center transition-opacity hover:opacity-70"
        data-page-top
        href="#top"
      >
        <span
          aria-hidden="true"
          class="-mb-[0.2rem] flex size-[1.6rem] items-center justify-center md:size-[16px]"
        >
          <img
            alt=""
            class="h-[0.7778rem] w-[1.4142rem] md:h-[7.778px] md:w-[14.142px]"
            height="8"
            loading="lazy"
            src={iconAssets.arrowUp}
            width="15"
          />
        </span>
        <span class="font-lato leading-body text-[1.4rem] tracking-[0.7px]">PAGE TOP</span>
      </a>
    </div>
  </div>

  <div class="bg-black pt-[5.2rem] pb-[4rem] md:py-[52px]">
    <div
      class="lp-container flex flex-col items-center gap-[2.4rem] md:flex-row md:items-center md:justify-between md:gap-0"
    >
      <div
        class="leading-body flex w-full flex-wrap justify-center gap-[2.5rem] border-b border-white/10 pb-[5.2rem] text-[1.4rem] tracking-[0.35px] md:w-auto md:gap-[28px] md:border-0 md:pb-0"
      >
        {
          footer.links.map((link) => (
            <a
              class="transition-opacity hover:opacity-70"
              href="#top"
            >
              {link}
            </a>
          ))
        }
      </div>
      <p class="font-lato leading-body text-center text-[1.4rem] tracking-[0.35px] md:text-left">
        {site.copyright}
      </p>
    </div>
  </div>
</footer>

<script>
  document.querySelector('[data-page-top]')?.addEventListener('click', (event) => {
    event.preventDefault();
    window.scrollTo({ behavior: 'smooth', top: 0 });
  });
</script>
