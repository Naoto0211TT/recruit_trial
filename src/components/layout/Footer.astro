---
import { lpAssets } from '@/constants/assets';
import { footer, site } from '@/constants/content';
---

<footer
  class="bg-dark-gray text-white"
  id="contact"
>
  <div
    class="flex flex-col gap-[6rem] px-[2rem] pt-[6rem] pb-[4rem] md:mx-auto md:max-w-[1440px] md:gap-[80px] md:px-[120px] md:pb-[60px]"
  >
    <div class="flex flex-col items-center">
      <div
        class="flex w-full flex-col items-center gap-[2rem] border-b border-white/10 pb-[2rem] md:w-auto md:border-0 md:pb-0"
      >
        <p class="text-[1.6rem] leading-[1.75] font-bold tracking-[0.4px]">{footer.telHeading}</p>
        <div class="flex items-center gap-[1.6rem] md:gap-[24px]">
          <img
            alt=""
            class="size-[5.2rem] md:size-[60px]"
            height="60"
            loading="lazy"
            src={lpAssets.iconPhoneCircle}
            width="60"
          />
          <div class="leading-none">
            <a
              class="font-lato text-[2.4rem] tracking-[0.48px] md:text-[36px] md:tracking-[0.72px]"
              href={`tel:${site.tel.replace(/-/g, '')}`}
            >
              {site.tel}
            </a>
            <p
              class="mt-[0.4rem] text-[1rem] tracking-[0.25px] md:text-[13px] md:tracking-[0.325px]"
            >
              {site.telHours}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center">
      <a
        class="group -mb-[0.2rem] flex flex-col items-center transition-opacity hover:opacity-70"
        data-page-top
        href="#top"
      >
        <img
          alt=""
          aria-hidden="true"
          class="size-[1.6rem] rotate-[-135deg]"
          height="16"
          loading="lazy"
          src={lpAssets.iconArrowUp}
          width="16"
        />
        <span class="font-lato leading-body text-[1.4rem] tracking-[0.7px]">PAGE TOP</span>
      </a>
    </div>
  </div>

  <div class="bg-black px-[2rem] pt-[5.2rem] pb-[4rem] md:px-0 md:pb-[52px]">
    <div
      class="flex flex-col items-center gap-[2.4rem] md:mx-auto md:max-w-[1440px] md:flex-row md:items-center md:justify-between md:px-[120px]"
    >
      <div
        class="leading-body flex w-full flex-wrap justify-center gap-[2.5rem] border-b border-white/10 pb-[5.2rem] text-[1.4rem] tracking-[0.35px] md:w-auto md:border-0 md:pb-0"
      >
        {
          footer.links.map((link) => (
            <a
              class="transition-opacity hover:opacity-70"
              href="#top"
            >
              {link}
            </a>
          ))
        }
      </div>
      <p class="font-lato leading-body text-center text-[1.4rem] tracking-[0.35px] md:text-left">
        {site.copyright}
      </p>
    </div>
  </div>
</footer>

<script>
  document.querySelector('[data-page-top]')?.addEventListener('click', (event) => {
    event.preventDefault();
    window.scrollTo({ behavior: 'smooth', top: 0 });
  });
</script>
