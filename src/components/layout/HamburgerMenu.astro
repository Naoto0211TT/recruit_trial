---
import Button from '@/components/ui/Button.astro';
import { lpAssets } from '@/constants/assets';
import { navItems, site } from '@/constants/content';
---

<div
  aria-hidden="true"
  class="fixed inset-0 z-[60] hidden bg-black/50"
  data-menu-overlay
>
</div>

<dialog
  class="bg-dark-gray fixed inset-0 z-[70] m-0 h-full max-h-none w-full max-w-none border-0 p-0 text-white open:flex open:flex-col"
  data-menu-dialog
  id="site-menu"
>
  <div class="flex items-start justify-end p-[1rem]">
    <button
      aria-label="メニューを閉じる"
      class="bg-dark-gray relative flex size-[6rem] items-center justify-center md:size-[100px]"
      data-menu-close
      type="button"
    >
      <span class="absolute block h-px w-[4.8rem] rotate-45 bg-[#d9d9d9]"></span>
      <span class="absolute block h-px w-[4.8rem] -rotate-45 bg-[#d9d9d9]"></span>
    </button>
  </div>

  <div
    class="flex flex-1 flex-col items-center justify-center overflow-y-auto px-[2rem] pb-[4rem] md:px-[120px] md:py-[120px]"
  >
    <div class="w-full max-w-[96rem] border-b border-white pb-[4rem]">
      <p class="text-[2.2rem] leading-normal font-light tracking-[2.6px] md:text-[26px]">
        {site.name}
      </p>
    </div>

    <div class="grid w-full max-w-[96rem] gap-[4rem] py-[4rem] md:grid-cols-2 md:gap-0">
      <div class="flex flex-col gap-[4rem] md:gap-[56px] md:py-[48px] md:pr-[100px]">
        <div class="flex gap-[2rem] md:gap-[36px]">
          <div
            class="flex size-[3.6rem] shrink-0 items-center justify-center rounded-full border border-white md:size-[52px]"
          >
            <img
              alt=""
              class="size-[1.6rem] md:size-[24px]"
              height="16"
              src={lpAssets.iconMail}
              width="24"
            />
          </div>
          <div class="flex flex-1 flex-col gap-[2rem] pt-[0.4rem] md:gap-[32px] md:pt-[12px]">
            <p class="text-[1.6rem] leading-normal font-bold">メールでのお問い合わせ</p>
            <Button
              class="w-full max-w-[29.2rem]"
              href="#contact"
            />
          </div>
        </div>

        <div class="flex gap-[2rem] md:gap-[36px]">
          <img
            alt=""
            class="size-[3.6rem] shrink-0 md:size-[52px]"
            height="52"
            src={lpAssets.iconPhoneCircle}
            width="52"
          />
          <div class="flex flex-1 flex-col gap-[2rem] pt-[0.4rem] md:pt-[12px]">
            <p class="text-[1.6rem] leading-normal font-bold">お電話でのお問い合わせ</p>
            <div class="leading-none">
              <a
                class="font-lato text-[2.8rem] tracking-[0.72px] md:text-[36px]"
                href={`tel:${site.tel.replace(/-/g, '')}`}
              >
                {site.tel}
              </a>
              <p class="mt-[0.4rem] text-[1.2rem] tracking-[0.325px] md:text-[13px]">
                {site.telHours}
              </p>
            </div>
          </div>
        </div>
      </div>

      <nav
        aria-label="サイト内メニュー"
        class="flex flex-col gap-[2.4rem] border-white/10 text-[1.8rem] leading-relaxed tracking-[0.45px] md:gap-[32px] md:border-l md:py-[48px] md:pl-[100px]"
      >
        {
          navItems.map((item) => (
            <a
              class="transition-opacity hover:opacity-70"
              data-menu-link
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu-dialog]');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

  const setExpanded = (expanded: boolean) => {
    openButtons.forEach((button) => {
      button.setAttribute('aria-expanded', String(expanded));
    });
  };

  const openMenu = () => {
    dialog?.showModal();
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setExpanded(true);
  };

  const closeMenu = () => {
    dialog?.close();
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
    setExpanded(false);
  };

  openButtons.forEach((button) => {
    button.addEventListener('click', openMenu);
  });

  closeButton?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  menuLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMenu();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeMenu();
  });
</script>

<style>
  [data-menu-dialog]::backdrop {
    background: transparent;
  }
</style>
