---
import Button from '@/components/ui/Button.astro';
import { lpAssets } from '@/constants/assets';
import { navItems, site } from '@/constants/content';
---

<div
  aria-hidden="true"
  class="fixed inset-0 z-[60] hidden bg-black/50"
  data-menu-overlay
>
</div>

<dialog
  class="bg-dark-gray fixed inset-0 z-[70] m-0 h-full max-h-none w-full max-w-none border-0 p-0 text-white open:flex open:flex-col"
  data-menu-dialog
  id="site-menu"
>
  <div class="flex items-start justify-end p-2.5">
    <button
      aria-label="メニューを閉じる"
      class="bg-dark-gray relative flex size-[60px] items-center justify-center md:size-[clamp(60px,6.9444vw,100px)]"
      data-menu-close
      type="button"
    >
      <span class="absolute block h-px w-12 rotate-45 bg-[#d9d9d9]"></span>
      <span class="absolute block h-px w-12 -rotate-45 bg-[#d9d9d9]"></span>
    </button>
  </div>

  <div
    class="flex flex-1 flex-col items-center justify-center overflow-y-auto px-5 pb-10 md:px-[clamp(20px,8.3333vw,120px)] md:py-[clamp(40px,8.3333vw,120px)]"
  >
    <div class="w-full max-w-[960px] border-b border-white pb-10">
      <p
        class="text-[22px] leading-normal font-light tracking-[2.6px] md:text-[clamp(22px,1.8056vw,26px)]"
      >
        {site.name}
      </p>
    </div>

    <div class="grid w-full max-w-[960px] gap-10 py-10 md:grid-cols-2 md:gap-0">
      <div
        class="flex flex-col gap-10 md:gap-[clamp(40px,3.8889vw,56px)] md:py-[clamp(0px,3.3333vw,48px)] md:pr-[clamp(0px,6.9444vw,100px)]"
      >
        <div class="flex gap-5 md:gap-[clamp(20px,2.5vw,36px)]">
          <div
            class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white md:size-[clamp(36px,3.6111vw,52px)]"
          >
            <img
              alt=""
              class="size-4 md:size-[clamp(16px,1.6667vw,24px)]"
              height="16"
              src={lpAssets.iconMail}
              width="24"
            />
          </div>
          <div
            class="flex flex-1 flex-col gap-5 pt-1 md:gap-[clamp(20px,2.2222vw,32px)] md:pt-[clamp(0px,0.8333vw,12px)]"
          >
            <p class="text-base leading-normal font-bold">メールでのお問い合わせ</p>
            <Button
              class="w-full max-w-[292px]"
              href="#contact"
            />
          </div>
        </div>

        <div class="flex gap-5 md:gap-[clamp(20px,2.5vw,36px)]">
          <img
            alt=""
            class="size-9 shrink-0 md:size-[clamp(36px,3.6111vw,52px)]"
            height="52"
            src={lpAssets.iconPhoneCircle}
            width="52"
          />
          <div class="flex flex-1 flex-col gap-5 pt-1 md:pt-[clamp(0px,0.8333vw,12px)]">
            <p class="text-base leading-normal font-bold">お電話でのお問い合わせ</p>
            <div class="leading-none">
              <a
                class="font-lato text-[28px] tracking-[0.72px] md:text-[clamp(28px,2.5vw,36px)]"
                href={`tel:${site.tel.replace(/-/g, '')}`}
              >
                {site.tel}
              </a>
              <p class="mt-1 text-xs tracking-[0.325px] md:text-[clamp(12px,0.9028vw,13px)]">
                {site.telHours}
              </p>
            </div>
          </div>
        </div>
      </div>

      <nav
        aria-label="サイト内メニュー"
        class="flex flex-col gap-6 border-white/10 text-lg leading-relaxed tracking-[0.45px] md:gap-[clamp(24px,2.2222vw,32px)] md:border-l md:py-[clamp(0px,3.3333vw,48px)] md:pl-[clamp(0px,6.9444vw,100px)]"
      >
        {
          navItems.map((item) => (
            <a
              class="transition-opacity hover:opacity-70"
              data-menu-link
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu-dialog]');
  const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

  const setExpanded = (expanded: boolean) => {
    openButtons.forEach((button) => {
      button.setAttribute('aria-expanded', String(expanded));
    });
  };

  const openMenu = () => {
    dialog?.showModal();
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setExpanded(true);
  };

  const closeMenu = () => {
    dialog?.close();
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
    setExpanded(false);
  };

  openButtons.forEach((button) => {
    button.addEventListener('click', openMenu);
  });

  closeButton?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  menuLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMenu();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeMenu();
  });
</script>

<style>
  [data-menu-dialog]::backdrop {
    background: transparent;
  }
</style>
