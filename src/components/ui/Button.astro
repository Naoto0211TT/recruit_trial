---
interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href = '#', label = 'お問い合わせ', class: className = 'md:w-[200px]' } = Astro.props;

const baseClass =
  'inline-flex h-[4.8rem] items-center justify-center border border-white px-[1rem] text-[1.4rem] leading-body font-bold tracking-[0.35px] text-white transition-opacity hover:opacity-80';
---

<a
  class:list={[baseClass, className]}
  href={href}
>
  {label}
</a>
