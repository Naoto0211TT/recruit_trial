---
interface Props {
  href?: string;
  label?: string;
  variant?: 'outline' | 'solid';
  class?: string;
}

const {
  href = '#',
  label = 'お問い合わせ',
  variant = 'outline',
  class: className = 'md:w-[200px]',
} = Astro.props;

const baseClass =
  'inline-flex h-[4.8rem] items-center justify-center px-[1rem] text-[1.4rem] leading-body font-bold tracking-[0.35px] transition-opacity hover:opacity-80';
---

<a
  class:list={[
    baseClass,
    variant === 'outline' ? 'border border-white text-white' : 'text-dark-gray bg-white',
    className,
  ]}
  href={href}
>
  {label}
</a>
