---
interface Props {
  en: string;
  sub: string;
  color?: 'primary' | 'white';
  class?: string;
}

const { en, sub, color = 'primary', class: className = '' } = Astro.props;

const isWhite = color === 'white';
---

<div
  class:list={[
    'relative flex flex-col gap-[0.4rem] pl-[1.2rem] md:gap-[12px] md:pl-0',
    isWhite ? 'text-white' : 'text-primary',
    className,
  ]}
>
  <p
    class:list={[
      'font-lato text-[4.2rem] leading-[1.75] font-medium tracking-[2.1px] md:text-[60px] md:tracking-[3px]',
      isWhite ? 'text-white' : 'text-primary',
    ]}
  >
    {en}
  </p>
  <p
    class:list={[
      'font-lato leading-body text-[1.2rem] tracking-[1.2px] opacity-50',
      isWhite ? 'text-white' : 'text-primary',
    ]}
  >
    {sub}
  </p>
  <span
    aria-hidden="true"
    class:list={[
      'absolute h-px w-[2rem]',
      isWhite ? 'bg-white' : 'bg-primary',
      'top-[9.1rem] -left-[3rem] md:top-[130px] md:-left-[40px]',
    ]}
  ></span>
</div>
