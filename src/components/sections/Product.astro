---
import ProductCard from '@/components/ui/ProductCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { lpAssets } from '@/constants/assets';
import { product } from '@/constants/content';

const productImages = [
  lpAssets.product01,
  lpAssets.product02,
  lpAssets.product03,
  lpAssets.product04,
];
---

<section
  class="bg-white"
  id="product"
>
  <div class="bg-primary pt-[6.4rem] pb-[13.2rem] md:pt-[136px] md:pb-[272px]">
    <div class="lp-container flex flex-col gap-[3.2rem] md:gap-[40px]">
      <SectionHeading
        color="white"
        en={product.heading.en}
        sub={product.heading.sub}
      />
      <div class="flex flex-col gap-[2rem] text-white md:gap-[24px]">
        <h2
          class="leading-heading text-[2.1rem] font-medium tracking-[0.525px] md:text-[24px] md:tracking-[0.6px]"
        >
          {product.lead}
        </h2>
        <p class="leading-body text-[1.6rem] tracking-[0.4px]">{product.body}</p>
      </div>
    </div>
  </div>

  <div
    class="lp-container relative -mt-[9.2rem] grid grid-cols-1 gap-[4rem] pb-[6.4rem] md:-mt-[195px] md:grid-cols-2 md:gap-x-[60px] md:gap-y-[60px] md:pb-[144px]"
  >
    {
      product.items.map((item, index) => (
        <ProductCard
          description={product.cardBody}
          image={productImages[index] ?? lpAssets.product01}
          imageAlt={`${item.title}のイメージ`}
          title={item.title}
        />
      ))
    }
  </div>
</section>
