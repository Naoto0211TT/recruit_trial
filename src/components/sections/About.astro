---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { lpAssets } from '@/constants/assets';
import { about } from '@/constants/content';
---

<section
  class="bg-white"
  id="about"
>
  <div class="md:mx-auto md:max-w-[1440px]">
    <div class="grid md:grid-cols-2">
      <div class="flex flex-col">
        <div
          class="flex flex-col gap-[5.2rem] px-[2rem] pt-[6.4rem] pb-[7.2rem] md:gap-[100px] md:px-[136px] md:pt-[120px] md:pr-[128px] md:pb-[120px]"
        >
          <SectionHeading
            en={about.heading.en}
            sub={about.heading.sub}
          />
          <div class="flex flex-col gap-[3.2rem] md:gap-[40px]">
            <h2
              class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px] md:text-[32px] md:tracking-[0.8px]"
            >
              {
                about.lead.map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))
              }
            </h2>
            <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.body}</p>
          </div>
        </div>

        <div
          class="bg-light-gray flex flex-col gap-[2rem] px-[2rem] pt-[5.2rem] pb-[6rem] md:gap-[40px] md:px-[120px] md:pt-[120px] md:pr-[148px] md:pb-[120px]"
        >
          <h3 class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]">
            {
              about.blockTitle.map((line) => (
                <>
                  {line}
                  <br class="hidden md:inline" />
                </>
              ))
            }
          </h3>
          <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.blockBody}</p>
        </div>
      </div>

      <div
        class="bg-primary flex flex-col gap-[6rem] px-[2rem] pt-[5.6rem] md:gap-[68px] md:px-[120px] md:pt-[140px]"
      >
        <div class="flex flex-col items-center gap-[2rem] md:items-start md:gap-[40px]">
          <div class="w-[28.8rem] md:w-[499px]">
            <img
              alt="ALOのイメージイラスト"
              class="h-[21.4rem] w-full object-contain md:h-[370px]"
              height="370"
              loading="lazy"
              src={lpAssets.aboutIllustration}
              width="499"
            />
          </div>
          <div class="flex w-full flex-col gap-[2.8rem] pl-0 md:pl-[60px]">
            <div>
              <p
                class="font-lato text-[3.6rem] leading-[1.75] font-medium tracking-[1.8px] text-white md:text-[84px] md:leading-none md:tracking-normal"
              >
                {about.brand.short}
              </p>
              <p
                class="font-lato leading-body mt-[0.4rem] text-[1.2rem] tracking-[1.2px] text-white md:mt-[12px] md:text-[24px] md:leading-none md:tracking-normal"
              >
                {about.brand.full}
              </p>
            </div>
            <span
              aria-hidden="true"
              class="block h-px w-[4rem] bg-white"
            ></span>
          </div>
        </div>

        <div class="-mx-[2rem] md:mx-0">
          <img
            alt="ALOの室内イメージ"
            class="aspect-square w-full object-cover md:aspect-auto md:h-[494px] md:w-full"
            height="494"
            loading="lazy"
            src={lpAssets.aboutInterior}
            width="480"
          />
        </div>
      </div>
    </div>

    <div
      class="grid items-start gap-[6rem] px-[2rem] pt-[4.8rem] pb-[7.2rem] md:grid-cols-2 md:items-center md:gap-0 md:px-0 md:py-0"
    >
      <div class="md:px-[120px] md:py-[124px]">
        <img
          alt="件数の推移グラフ"
          class="mx-auto w-full max-w-[33.5rem] md:max-w-[570px]"
          height="492"
          loading="lazy"
          src={lpAssets.chart}
          width="570"
        />
      </div>
      <div class="flex flex-col gap-[2.8rem] md:gap-[40px] md:pr-[120px]">
        <h3 class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]">
          {
            about.chart.title.map((line) => (
              <>
                {line}
                <br class="hidden md:inline" />
              </>
            ))
          }
        </h3>
        <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.chart.body}</p>
      </div>
    </div>
  </div>
</section>
