---
import BreakLines from '@/components/ui/BreakLines.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { lpAssets } from '@/constants/assets';
import { about } from '@/constants/content';
---

<section
  class="bg-white"
  id="about"
>
  <div class="grid md:grid-cols-2">
    <div
      class="flex min-w-0 flex-col md:self-start"
      data-about-col="text"
    >
      <div
        class="lp-pad-l min-w-0 px-[2rem] pt-[6.4rem] pb-[7.2rem] md:px-0 md:pt-[120px] md:pb-[120px]"
      >
        <div
          class="flex min-w-0 flex-col gap-[5.2rem] md:[margin-right:min(12.8rem,max(0px,calc(100%-45.6rem)))] md:ml-auto md:w-full md:max-w-[456px] md:gap-[100px]"
        >
          <div
            class="lp-break-lock"
            style="--lp-break-lock-w: 45.6rem; --lp-break-lock-gap: 0px"
          >
            <SectionHeading
              en={about.heading.en}
              sub={about.heading.sub}
            />
          </div>
          <div class="flex min-w-0 flex-col gap-[3.2rem] md:gap-[40px]">
            <h2
              class="lp-break-lock text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px] md:text-[32px] md:tracking-[0.8px]"
              style="--lp-break-lock-w: 45.6rem; --lp-break-lock-gap: 0px"
            >
              <BreakLines lines={about.lead} />
            </h2>
            <p
              class="leading-body w-full min-w-0 text-[1.6rem] tracking-[0.4px] md:max-w-[45.6rem]"
            >
              {about.body}
            </p>
          </div>
        </div>
      </div>

      <div
        class="lp-pad-l bg-light-gray min-w-0 px-[2rem] pt-[5.2rem] pb-[6rem] md:px-0 md:pt-[120px] md:pb-[120px]"
      >
        <div
          class="flex min-w-0 flex-col gap-[2rem] md:[margin-right:min(14.8rem,max(0px,calc(100%-45.2rem)))] md:ml-auto md:w-full md:max-w-[452px] md:gap-[40px]"
        >
          <h3
            class="lp-break-lock text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]"
            style="--lp-break-lock-w: 45.2rem; --lp-break-lock-gap: 0px"
          >
            <BreakLines
              lines={about.blockTitle}
              pcOnly
            />
          </h3>
          <p class="leading-body w-full min-w-0 text-[1.6rem] tracking-[0.4px] md:max-w-[45.2rem]">
            {about.blockBody}
          </p>
        </div>
      </div>
    </div>

    <div
      class="bg-primary flex flex-col gap-[6rem] px-[2rem] pt-[5.6rem] md:relative md:gap-[68px] md:pt-[140px] md:pr-0 md:pl-[120px]"
      data-about-col="visual"
    >
      <div class="flex flex-col items-center gap-[2rem] md:items-start md:gap-[40px]">
        <div class="w-[28.8rem] md:w-[499px] md:shrink-0 md:-translate-x-[45px]">
          <img
            alt="ALOのイメージイラスト"
            class="h-auto w-full"
            height="371"
            loading="lazy"
            src={lpAssets.aboutIllustration}
            width="500"
          />
        </div>
        <div class="flex w-full flex-col gap-[2.8rem] pl-0 md:w-[480px] md:pl-[60px]">
          <div>
            <p
              class="font-lato text-[3.6rem] leading-[1.75] font-medium tracking-[1.8px] text-white md:text-[48px] md:tracking-[2.4px]"
            >
              {about.brand.short}
            </p>
            <p
              class="font-lato leading-body mt-[0.4rem] text-[1.2rem] tracking-[1.2px] text-white md:mt-[12px] md:text-[12px] md:leading-[2] md:tracking-[1.2px]"
            >
              {about.brand.full}
            </p>
          </div>
          <span
            aria-hidden="true"
            class="block h-px w-[4rem] bg-white"
          ></span>
        </div>
      </div>

      <div class="-mx-[2rem] md:relative md:z-10 md:mx-0 md:w-full md:max-w-[600px]">
        <img
          alt="ALOの室内イメージ"
          class="aspect-square w-full object-cover"
          height="600"
          loading="lazy"
          src={lpAssets.aboutInterior}
          width="600"
        />
      </div>
    </div>
  </div>

  <div class="lp-container md:py-0">
    <div
      class="grid items-start gap-[6rem] pt-[4.8rem] pb-[7.2rem] md:grid-cols-2 md:gap-[60px] md:pt-[124px] md:pb-[148px]"
    >
      <div class="min-w-0">
        <img
          alt="件数の推移グラフ"
          class="mx-auto aspect-[335/288.036] w-full max-w-[33.5rem] object-contain md:hidden"
          height="288"
          loading="lazy"
          src={lpAssets.chartSp}
          width="335"
        />
        <img
          alt="件数の推移グラフ"
          class="hidden w-full md:block"
          height="492"
          loading="lazy"
          src={lpAssets.chartPc}
          width="570"
        />
      </div>
      <div
        class="flex min-w-0 flex-col gap-[2.8rem] md:mt-[136px] md:ml-auto md:w-full md:max-w-[480px] md:gap-[40px]"
      >
        <h3
          class="lp-break-lock text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]"
          style="--lp-break-lock-w: 48rem; --lp-break-lock-gap: 0px"
        >
          <BreakLines
            lines={about.chart.title}
            pcOnly
          />
        </h3>
        <p class="leading-body w-full min-w-0 text-[1.6rem] tracking-[0.4px]">
          {about.chart.body}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const textCol = document.querySelector<HTMLElement>('[data-about-col="text"]');
  const visualCol = document.querySelector<HTMLElement>('[data-about-col="visual"]');
  const desktopQuery = window.matchMedia('(min-width: 768px)');

  const syncVisualColHeight = () => {
    if (!textCol || !visualCol) return;

    if (!desktopQuery.matches) {
      visualCol.style.height = '';
      return;
    }

    visualCol.style.height = `${textCol.offsetHeight}px`;
  };

  syncVisualColHeight();
  window.addEventListener('resize', syncVisualColHeight);
  desktopQuery.addEventListener('change', syncVisualColHeight);
  document.fonts?.ready.then(syncVisualColHeight);

  if (textCol) {
    new ResizeObserver(syncVisualColHeight).observe(textCol);
  }
</script>
