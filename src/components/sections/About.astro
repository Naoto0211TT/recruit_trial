---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { lpAssets } from '@/constants/assets';
import { about } from '@/constants/content';
---

<section
  class="bg-white"
  id="about"
>
  <div class="grid md:grid-cols-2">
    <div
      class="flex flex-col md:self-start"
      data-about-col="text"
    >
      <div
        class="px-[2rem] pt-[6.4rem] pb-[7.2rem] md:pt-[120px] md:pr-[128px] md:pb-[120px] md:pl-0"
      >
        <div class="flex flex-col gap-[5.2rem] md:ml-auto md:max-w-[456px] md:gap-[100px]">
          <SectionHeading
            en={about.heading.en}
            sub={about.heading.sub}
          />
          <div class="flex flex-col gap-[3.2rem] md:gap-[40px]">
            <h2
              class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px] md:text-[32px] md:tracking-[0.8px]"
            >
              {
                about.lead.map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))
              }
            </h2>
            <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.body}</p>
          </div>
        </div>
      </div>

      <div
        class="bg-light-gray px-[2rem] pt-[5.2rem] pb-[6rem] md:pt-[120px] md:pr-[148px] md:pb-[120px] md:pl-0"
      >
        <div class="flex flex-col gap-[2rem] md:ml-auto md:max-w-[452px] md:gap-[40px]">
          <h3 class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]">
            {
              about.blockTitle.map((line) => (
                <>
                  {line}
                  <br class="hidden md:inline" />
                </>
              ))
            }
          </h3>
          <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.blockBody}</p>
        </div>
      </div>
    </div>

    <div
      class="bg-primary flex flex-col gap-[6rem] px-[2rem] pt-[5.6rem] md:relative md:gap-[68px] md:px-[120px] md:pt-[140px]"
      data-about-col="visual"
    >
      <div class="flex flex-col items-center gap-[2rem] md:items-start md:gap-[40px]">
        <div class="w-[28.8rem] md:w-[499px] md:-translate-x-[45px]">
          <img
            alt="ALOのイメージイラスト"
            class="h-auto w-full"
            height="371"
            loading="lazy"
            src={lpAssets.aboutIllustration}
            width="500"
          />
        </div>
        <div class="flex w-full flex-col gap-[2.8rem] pl-0 md:w-[480px] md:pl-[60px]">
          <div>
            <p
              class="font-lato text-[3.6rem] leading-[1.75] font-medium tracking-[1.8px] text-white md:text-[48px] md:tracking-[2.4px]"
            >
              {about.brand.short}
            </p>
            <p
              class="font-lato leading-body mt-[0.4rem] text-[1.2rem] tracking-[1.2px] text-white md:mt-[12px] md:text-[12px] md:leading-[2] md:tracking-[1.2px]"
            >
              {about.brand.full}
            </p>
          </div>
          <span
            aria-hidden="true"
            class="block h-px w-[4rem] bg-white"
          ></span>
        </div>
      </div>

      <div class="-mx-[2rem] md:relative md:z-10 md:mx-0 md:w-[600px] md:shrink-0">
        <img
          alt="ALOの室内イメージ"
          class="aspect-square w-full object-cover md:aspect-auto md:h-[600px] md:w-[600px] md:max-w-none"
          height="600"
          loading="lazy"
          src={lpAssets.aboutInterior}
          width="600"
        />
      </div>
    </div>
  </div>

  <div class="md:mx-auto md:max-w-[1440px]">
    <div
      class="grid items-start gap-[6rem] px-[2rem] pt-[4.8rem] pb-[7.2rem] md:grid-cols-[720px_1fr] md:items-center md:gap-[120px] md:px-0 md:py-0"
    >
      <div class="md:pt-[124px] md:pr-0 md:pb-[148px] md:pl-[120px]">
        <img
          alt="件数の推移グラフ"
          class="mx-auto w-full max-w-[33.5rem] md:hidden"
          height="289"
          loading="lazy"
          src={lpAssets.chartSp}
          width="335"
        />
        <img
          alt="件数の推移グラフ"
          class="hidden md:mx-0 md:block md:w-[570px]"
          height="492"
          loading="lazy"
          src={lpAssets.chartPc}
          width="570"
        />
      </div>
      <div class="flex flex-col gap-[2.8rem] md:gap-[40px] md:pr-[120px]">
        <h3 class="text-primary leading-heading text-[2.4rem] font-medium tracking-[0.6px]">
          {
            about.chart.title.map((line, index) => (
              <>
                {index > 0 && <br class="hidden md:inline" />}
                {line}
              </>
            ))
          }
        </h3>
        <p class="leading-body text-[1.6rem] tracking-[0.4px]">{about.chart.body}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const textCol = document.querySelector<HTMLElement>('[data-about-col="text"]');
  const visualCol = document.querySelector<HTMLElement>('[data-about-col="visual"]');
  const desktopQuery = window.matchMedia('(min-width: 768px)');

  const syncVisualColHeight = () => {
    if (!textCol || !visualCol) return;

    if (!desktopQuery.matches) {
      visualCol.style.height = '';
      return;
    }

    visualCol.style.height = `${textCol.offsetHeight}px`;
  };

  syncVisualColHeight();
  window.addEventListener('resize', syncVisualColHeight);
  desktopQuery.addEventListener('change', syncVisualColHeight);
  document.fonts?.ready.then(syncVisualColHeight);

  if (textCol) {
    new ResizeObserver(syncVisualColHeight).observe(textCol);
  }
</script>
