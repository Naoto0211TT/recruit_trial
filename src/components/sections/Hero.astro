---
import { lpAssets } from '@/constants/assets';
import { hero, site } from '@/constants/content';
---

<section
  class="bg-dark-gray relative text-white"
  data-hero
>
  <div class="relative overflow-hidden">
    <div class="relative -mb-[3.2rem] aspect-square w-full md:mb-0 md:aspect-auto md:w-[69.444%]">
      <img
        alt=""
        class="block w-full"
        fetchpriority="high"
        height="900"
        src={lpAssets.heroBg}
        width="1000"
      />
    </div>

    <div class="relative md:absolute md:inset-y-0 md:left-[50%] md:w-[50%]">
      <div
        aria-hidden="true"
        class="absolute top-0 left-0 hidden h-full w-[38.889%] bg-black/50 md:block"
      >
      </div>

      <div
        class="bg-dark-gray relative flex flex-col gap-[3.6rem] px-[2rem] pt-0 pb-[9.6rem] md:h-full md:translate-y-[32.5px] md:justify-center md:gap-[64px] md:bg-transparent md:px-[76px] md:pb-0"
      >
        <div class="flex flex-col gap-[3.6rem] md:gap-[64px]">
          <p class="hidden leading-[1.25] font-light tracking-[2.6px] md:block md:text-[26px]">
            {site.name}
          </p>
          <div class="w-full max-w-[33.5rem] md:max-w-[563px]">
            <img
              alt="ALO ANIMAL LIBERATION ORCHESTRA"
              class="h-[6.7rem] w-full object-contain object-left md:h-[113px]"
              height="113"
              src={lpAssets.logoAlo}
              width="563"
            />
          </div>
        </div>

        <div class="flex w-full flex-col gap-[2.8rem] md:gap-[60px]">
          <div class="flex flex-col gap-[2rem]">
            <p
              class="text-[2.5rem] leading-none tracking-[3.5px] md:text-[38px] md:tracking-[5.32px]"
            >
              {hero.catchCopy}
            </p>
            <p
              class="font-lato text-[1.2rem] leading-none font-light tracking-[2.58px] md:text-[18px] md:tracking-[3.87px]"
            >
              {hero.subCopy}
            </p>
          </div>
          <p
            class="leading-body text-[1.4rem] tracking-[0.35px] md:text-[16px] md:font-bold md:tracking-[0.4px]"
          >
            {
              hero.description.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))
            }
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
