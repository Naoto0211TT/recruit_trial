{
  "name": "lw-recruit-trial",
  "type": "module",
  "version": "2.0.0",
  "description": "リネアワークス中途採用コーディングテスト",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lineaworks/recruit_trial.git"
  },
  "author": "Lineaworks inc.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lineaworks/recruit_trial/issues"
  },
  "homepage": "https://github.com/lineaworks/recruit_trial#readme",
  "engines": {
    "node": "24.18.0",
    "npm": "11.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint-html:astro": "markuplint --fix --allow-warnings 'src/**/*.astro'",
    "lint-html": "run-s lint-html:*",
    "lint-script:config": "eslint './*.{js,cjs,mjs,ts}' --fix --ignore-pattern '!.*rc.cjs' --ignore-pattern '!*.config.{js,cjs,mjs,ts}' --no-error-on-unmatched-pattern",
    "lint-script:task": "eslint './script/node/*.{js,cjs,mjs,ts}' --fix --no-error-on-unmatched-pattern",
    "lint-script:src": "eslint './src/**/*.{js,jsx,cjs,mjs,ts,tsx,astro}' --fix --no-error-on-unmatched-pattern",
    "lint-script": "run-s lint-script:*",
    "prettier:config": "prettier --write --no-error-on-unmatched-pattern './*.{js,cjs,mjs,ts}'",
    "prettier:task": "prettier --write --no-error-on-unmatched-pattern './script/node/*.ts'",
    "prettier:src": "prettier --write --no-error-on-unmatched-pattern './src/**/*.{js,jsx,cjs,mjs,ts,tsx,astro,css,scss}'",
    "prettier": "run-s prettier:*",
    "format": "run-s lint-html lint-script prettier",
    "check:typescript": "tsc --noEmit",
    "check:astro": "astro check",
    "check": "run-s check:*",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@markuplint/astro-parser": "^4.18.3",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-unicorn": "^69.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "markuplint": "^4.18.3",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.62.1"
  }
}
